{
  "name": "social-content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clean": "bun run clean:out && bun run dev",
    "copy-monaco": "bun scripts/copy-monaco.ts",
    "prebuild": "bun run copy-monaco",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "bun test",
    "test:agent": "bun test tests/services/agent.test.ts",
    "test:guards": "bun test tests/security/confinement.test.ts tests/services/lifecycle.test.ts tests/services/agent.test.ts",
    "verify": "bun run typecheck && bun test && bun run build",
    "verify:quick": "bunx tsc --noEmit -p tsconfig.node.json && bunx tsc --noEmit -p tsconfig.web.json && bun test",
    "clean:out": "bun scripts/clean-out.ts",
    "workspace:init": "bun scripts/init-workspace.ts",
    "workspace:reset": "bun scripts/reset-workspace.ts",
    "workspace:seed-demo": "bun scripts/seed-demo-content.ts",
    "agent:list": "bun scripts/agent-list.ts",
    "agent:check": "bun scripts/agent-check.ts",
    "agent:demo": "bun scripts/agent-demo.ts",
    "agent:emulator": "bun scripts/agent-emulator.ts",
    "demo": "bun run workspace:reset && bun run agent:emulator",
    "pack": "electron-builder --win",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.500.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^35.0.0",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "electron-builder": "^25.0.0"
  }
}
