{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": ".",
    "lib": ["ES2024"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@preload/*": ["src/preload/*"],
      "@shared/*": ["packages/shared/src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "packages/shared/src/**/*",
    "electron.vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/renderer"]
}
